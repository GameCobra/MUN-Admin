@model MUNAdmin.Models.DelegationInstance;

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>MUNInstance</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DelegationCountry)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DelegationCountry)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DelegationAccsesCode)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DelegationAccsesCode)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CouncilList)
        </dt>
        <dd class="col-sm-10">
            <div class="container py-5">


                    @for (int i = 0; i < Model.CouncilList.Count(); i++)
                    {
                    <div class="row g-4">
                        @Model.CouncilList[i].Council.CouncilName
                    </div>
                    }
            </div>
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

@model MUNAdmin.Models.DelegationInstance
@{
    string currentMUNTitle = "Test MUN";
    string currentCouncilName = "Security";
    DelegationCouncil currentDelegationCouncil = Model.CouncilList.First(x => x.Council.CouncilName == currentCouncilName);
    CouncilInformation currentCouncilInformation = currentDelegationCouncil.Council;
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background:#f5f5f5;
        }

        .main-panel,
        .side-panel{
            background: #@currentCouncilInformation.SecondaryColor;
            border-radius:20px;
            padding:25px;
            min-height:500px;
            box-shadow:0 0 10px rgba(0,0,0,.1);
        }

        .menu-item{
            padding:12px;
            border-radius:10px;
            margin-bottom:10px;
            cursor:pointer;
        }

        .menu-item:hover{
                background: #00000010;
        }

        .card-button{
            height:140px;
            border:2px solid;
            border-color: #@currentCouncilInformation.PrimaryColor;
            border-radius:15px;
            display:flex;
            justify-content:center;
            align-items:center;
            font-size:1.2rem;
            transition:.2s;
            cursor:pointer;
        }

        .card-button:hover{
            background: #00000010;
        }

        .Request-Rebuttal-card-button{
            height: 50px;
            border: 4px solid;
            border-color: #@(currentDelegationCouncil.RequestedRebuttal ? "26f007" : "d11d1d");
        }
    </style>
</head>
<body>
    <h2 class="mb-4">@currentMUNTitle</h2>
    <div class="container py-5">

        <div class="row g-4">

            <!-- Left Panel -->
            <div class="col-lg-8">
                <div class="main-panel">

                    <h2 class="mb-4">@currentCouncilInformation.CouncilName</h2>

                    <div class="row g-4 py-4">

                        <div class="col-md-3">
                            <div class="card-button Request-Rebuttal-card-button">Request Point</div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="card-button">Button 2</div>
                        </div>

                        <div class="col-md-4">
                            <div class="card-button">Button 3</div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Panel -->
            <div class="col-lg-4">
                <div class="side-panel">

                    <h4>Navigation</h4>

                    <div class="menu-item">1</div>
                    <div class="menu-item">2</div>
                    <div class="menu-item">3</div>
                    <div class="menu-item">4</div>
                    <div class="menu-item">5</div>

                </div>
            </div>

        </div>

    </div>

</body>

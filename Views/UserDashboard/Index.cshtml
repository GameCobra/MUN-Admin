@model MUNAdmin.Models.ViewModels.DelegationDashboardViewModel

@{

}

<style>
    .council-bar {
        background: linear-gradient(100deg, #@(Model.GradiantPrimaryColor), #@(Model.GradiantSecondaryColor));
        color: white;
        border-radius: 12px;
    }

    .council-tab {
        border: none;
        background: transparent;
        color: #64748b;
        padding: 7px 14px;
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
        transition: .15s;
    }

    .council-tab:hover {
        background: #f1f5f9;
        color: #1e293b;
    }

    .council-tab.active {
        background: #2563eb;
        color: white;
    }

</style>

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="card border rounded-3 mb-3">
        <div class="card-body py-3 px-4">
            <div class="d-flex justify-content-between align-items-center">

                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle text-primary d-flex
                                align-items-center justify-content-center fw-bold"
                         style="width: 36px; height: 36px; background-color:#eff6ff; color:#2563eb">
                        CA
                    </div>

                    <div>
                        <h1 class="h5 fw-bold mb-0">@(Model.MUNTitle)</h1>
                        <div class="small text-secondary">Delegate Dashboard</div>
                    </div>
                </div>

                <div class="text-end d-none d-sm-block">
                    <div class="fw-semibold small">@(Model.DelegationCountry)</div>
                    <div class="small text-secondary">Delegate</div>
                </div>

            </div>
        </div>
    </div>

    <!-- Council Selector -->
    <div class="card border rounded-3 mb-3">
        <div class="card-body p-2">
            <div class="d-flex gap-2 overflow-auto">

                @for (int i = 0; i < Model.CouncilNames.Count; i++)
                {
                    if (Model.CouncilNames[i] == Model.CurrentCouncilName)
                    {
                        <button type="button"
                        class="flex-shrink-0 council-tab active">
                            @(Model.CouncilNames[i])
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="flex-shrink-0 council-tab">
                            @(Model.CouncilNames[i])
                        </button>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Current Council -->
    <div class="card text-white border-0 rounded-3 mb-3">
        <div class="card-body py-3 px-4 council-bar">
            <div class="row align-items-center">

                <div class="col">
                    <span class="badge bg-light bg-opacity-10 text-white rounded-pill mb-1">

                        @if (Model.SessionActive)
                        {
                            <span class="d-inline-block rounded-circle me-1"
                                  style="width: 7px; height: 7px; background-color:#27f272"></span>
                            <span>Session in progress</span>
                        }
                        else
                        {
                            <span class="d-inline-block rounded-circle me-1"
                                  style="width: 7px; height: 7px; background-color:#eb4034"></span>
                            <span>Session not active</span>
                        }

                    </span>

                    <h2 class="h5 fw-bold mb-0">@(Model.CurrentCouncilName)</h2>
                    <div class="small opacity-75">Current council</div>
                </div>

                <div class="col-auto text-end">
                    <div class="small text-uppercase opacity-75">Representing</div>
                    <div class="fw-bold">@(Model.DelegationCountry)</div>
                </div>

            </div>
        </div>
    </div>

    <!-- Main Area -->
    <div class="row g-3">

        <!-- Resolutions -->
        <div class="col-lg-8">

            <div class="card border rounded-3 h-100">

                <div class="card-header bg-white py-3 px-3">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <div class="fw-bold">Resolutions</div>
                            <div class="small text-secondary">
                                Click a resolution to view or propose amendments
                            </div>
                        </div>

                        <span class="small text-secondary">@(Model.ParticipatingCouncil.Resolutions.Count()) total</span>

                    </div>
                </div>

                <div class="card-body p-3">
                    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2">

                        @for (int i = 0; i < Model.ParticipatingCouncil.Resolutions.Count(); i++)
                        {
                            Resolution currentResolution = Model.ParticipatingCouncil.Resolutions[i];
                            <!-- Resolution 1 -->
                            <div class="col">
                                <button type="button"
                                class="card h-100 w-100 text-start border rounded-3 bg-white p-3"
                                data-bs-toggle="modal"
                                data-bs-target=@("#ResolutionPopup" + i)>

                                    <div class="d-flex flex-column h-100">

                                        <span class="badge text-primary align-self-start"
                                        style="background-color:#eff6ff; color:#2563eb">
                                            @(currentResolution.Code)
                                        </span>

                                        <div class="fw-bold mt-2">@(currentResolution.Title)</div>

                                        <div class="small text-secondary mt-1">
                                            @(currentResolution.BodyText)
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center
                                                border-top mt-auto pt-2">
                                            <span class="small text-secondary">
                                                @(Model.AmmendmentsOnResolutions[i].Count()) Ammendments
                                            </span>
                                            <span class="small fw-bold text-primary">View →</span>
                                        </div>

                                    </div>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">

            <div class="card border rounded-3">

                <!-- Quick Actions -->
                <div class="card-body p-3">

                    <div class="small fw-bold text-uppercase text-secondary mb-2">
                        Actions
                    </div>

                    <button type="button"
                            class="btn btn-danger bg-danger-subtle text-danger border-0
                                   w-100 text-start mb-2 p-2"
                            data-bs-toggle="modal"
                            data-bs-target="#RebuttalModal">

                        <span class="fw-bold d-block">Request Rebuttal</span>
                        <span class="small">Request speaking time</span>

                    </button>

                    <button type="button"
                            class="btn btn-light border w-100 text-start mb-2 p-2">
                        <span class="badge text-primary me-2"
                              style="background-color:#eff6ff; color:#2563eb">?</span>
                        <span>
                            <span class="fw-semibold d-block small">Council Information</span>
                            <span class="text-secondary" style="font-size: .75rem;">
                                View council details
                            </span>
                        </span>
                    </button>

                    <button type="button"
                            class="btn btn-light border w-100 text-start p-2">
                        <span class="badge text-primary me-2"
                              style="background-color:#eff6ff; color:#2563eb">#</span>
                        <span>
                            <span class="fw-semibold d-block small">My Delegation</span>
                            <span class="text-secondary" style="font-size: .75rem;">
                                View delegation details
                            </span>
                        </span>
                    </button>

                </div>

                <div class="border-top"></div>

                <!-- Session -->
                <div class="card-body p-3">

                    <div class="small fw-bold text-uppercase text-secondary mb-2">
                        Session
                    </div>

                    <div class="row g-2">

                        <div class="col-6">
                            <div class="bg-body-tertiary rounded-2 p-2">
                                <div class="small text-secondary">STATUS</div>
                                <div class="fw-bold text-success small">Active</div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="bg-body-tertiary rounded-2 p-2">
                                <div class="small text-secondary">RESOLUTIONS</div>
                                <div class="fw-bold small">6</div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="bg-body-tertiary rounded-2 p-2">
                                <div class="small text-secondary">AMENDMENTS</div>
                                <div class="fw-bold small">7</div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="bg-body-tertiary rounded-2 p-2">
                                <div class="small text-secondary">COUNTRY</div>
                                <div class="fw-bold small">Canada</div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>


<!-- Resolution Modal -->

@for (int i = 0; i < Model.ParticipatingCouncil.Resolutions.Count(); i++)
{
    Resolution currentResolution = Model.ParticipatingCouncil.Resolutions[i];
    <div class="modal fade"
    id=@("ResolutionPopup" + i)
    tabindex="-1"
    aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <div>
                        <div class="small fw-bold text-primary">C1</div>
                        <h5 class="modal-title">T1</h5>
                    </div>

                    <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="bg-body-tertiary border rounded-3 p-3 mb-3">
                        This is where the complete resolution text would be displayed.
                    </div>

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <strong>Amendments</strong>
                            <div class="small text-secondary">2 amendments submitted</div>
                        </div>

                        <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#AmendmentModal">
                            + Add Amendment
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>
}

<!-- Amendment Modal -->
<div class="modal fade"
     id="AmendmentModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <div class="small fw-bold text-primary">C1 - T1</div>
                    <h5 class="modal-title">Create Amendment</h5>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form method="post"
                  action="/UserDashboard/CreateAmendment">

                <div class="modal-body">

                    <input type="hidden"
                           name="resolutionId"
                           value="1">

                    <label class="form-label fw-semibold">
                        Amendment
                    </label>

                    <textarea class="form-control"
                              name="amendmentText"
                              rows="5"
                              placeholder="Enter your proposed amendment..."></textarea>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Submit Amendment
                    </button>

                </div>
            </form>

        </div>
    </div>
</div>


<!-- Rebuttal Modal -->
<div class="modal fade"
     id="RebuttalModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Request Rebuttal
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form method="post"
                  action="/UserDashboard/UserRequestRebutal">

                <div class="modal-body">

                    <input type="hidden"
                           name="councilId"
                           value="2">

                    <input type="hidden"
                           name="desiredStateStr"
                           value="value">

                    <p class="text-secondary small">
                        Request speaking time to respond to another
                        delegate during the current session.
                    </p>

                    <textarea class="form-control"
                              name="reason"
                              rows="3"
                              placeholder="Reason (optional)"></textarea>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Request Rebuttal
                    </button>

                </div>
            </form>

        </div>
    </div>
</div>
